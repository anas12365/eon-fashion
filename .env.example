# Copy to .env and fill in. Never commit the real .env.
#
# These are the frontend (Vite) environment variables actually read by
# src/ — see src/services/api.js. Backend environment variables live
# separately in backend/.env.example (a different app, a different
# process).

# --- Django API -------------------------------------------------------
# Base URL of the Django REST API (see /backend). Include the /api suffix.
VITE_API_BASE_URL=http://localhost:8000/api
