# Copy to .env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

DB_NAME=eon_db
DB_USER=eon_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Comma-separated origins allowed to call this API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- HTTPS / cookie hardening (Phase 6.1) ---------------------------------
# Leave all of these False/0 for local HTTP development. Set to
# True/a real value once deployed behind HTTPS — see the "Deployment
# checklist" section of backend/README.md before enabling.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Only set to True if a reverse proxy (nginx/Caddy) terminates TLS in
# front of this app and sets X-Forwarded-Proto itself.
DJANGO_SECURE_PROXY_SSL_HEADER=False

# Admin login rate limit (Phase 6.1) — applies only to POST /api/auth/login/
ADMIN_LOGIN_THROTTLE_RATE=5/min

# Log verbosity for the 'django' and 'eon' loggers (see LOGGING in
# settings.py). Defaults to INFO when DJANGO_DEBUG=True, WARNING otherwise.
DJANGO_LOG_LEVEL=INFO

# --- Upload size limits (Phase 6.2/6.3) -----------------------------------
# Django's unconfigured default is 2.5MB, which sits below the frontend's
# own 5MB-per-original-file cap (src/lib/storage.js / djangoStorage.js
# MAX_IMAGE_BYTES) — a legitimately sized pre-optimization product photo
# could 400 before reaching the view. Both default to 10MB below if unset;
# only override if you need a different ceiling. Value is in bytes.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
